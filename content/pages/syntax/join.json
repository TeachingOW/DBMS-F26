          },
          "children": [
            "Combine rows from two tables when the ON condition is true."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "SELECT [DISTINCT] column_list\nFROM first_table AS a\nJOIN second_table AS b\n  ON a.key = b.key\n[WHERE condition];"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
