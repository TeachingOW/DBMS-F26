                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "ON defines how rows match."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "A one-to-many match produces multiple result rows."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "Qualify ambiguous columns with table aliases."
                  ]
                }
              ]
            }
          ]
