  "schemaVersion": 1,
  "title": "LEFT JOIN · SQL Syntax",
  "bodyAttributes": {},
  "nodes": [
    {
      "tag": "header",
      "children": [
        {
          "tag": "p",
          "attrs": {
            "class": "eyebrow"
          },
          "children": [
            "SQL general syntax"
          ]
        },
        {
          "tag": "h1",
          "children": [
            "LEFT JOIN"
          ]
        }
      ]
    },
    {
      "tag": "main",
      "children": [
        "\n    ",
        {
          "tag": "p",
          "attrs": {
            "class": "lead"
          },
          "children": [
            "Keep every row from the left table and attach matching right-table data when available."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "SELECT column_list\nFROM left_table AS l\nLEFT JOIN right_table AS r\n  ON l.key = r.key\n[WHERE condition];"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "pattern"
                  },
                  "children": [
                    "Copy general pattern"
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "Unmatched left rows remain in the result."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "Columns from a missing right row become NULL."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "A right-table filter in WHERE can accidentally turn the result into an inner join."
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "Example using the course database"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "SELECT p.name, pu.buyer\nFROM Product p\nLEFT JOIN Purchase pu ON pu.product = p.name;"
                  ]
                }
              ]
            },
            {
