                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "CREATE TABLE table_name (\n  column_name data_type [constraint],\n  ...\n);\n\nINSERT INTO table_name (column_name, ...)\nVALUES (value, ...), (...);"
                  ]
                }
              ]
            },
