        },
        {
          "tag": "h1",
          "children": [
            "Recursive common table expression"
          ]
        }
      ]
    },
    {
      "tag": "main",
      "children": [
        "\n    ",
        {
          "tag": "p",
          "attrs": {
            "class": "lead"
          },
          "children": [
            "Repeatedly apply a query to traverse hierarchical or graph-shaped data."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "WITH RECURSIVE cte_name AS (\n  anchor_query\n  UNION ALL\n  recursive_query_that_references_cte\n)\nSELECT column_list\nFROM cte_name;"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "pattern"
                  },
                  "children": [
                    "Copy general pattern"
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "The anchor query produces starting rows."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "The recursive query refers to the CTE and produces the next level."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "Recursion stops when an iteration produces no new rows."
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "Example using the course database"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "WITH RECURSIVE org AS (\n  SELECT employee_id, manager_id, employee_name, 0 AS depth\n  FROM Employee WHERE manager_id IS NULL\n  UNION ALL\n  SELECT e.employee_id, e.manager_id, e.employee_name, o.depth + 1\n  FROM Employee e JOIN org o ON e.manager_id = o.employee_id\n)\nSELECT * FROM org ORDER BY depth, employee_id;"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
