      "tag": "main",
      "children": [
        "\n    ",
        {
          "tag": "p",
          "attrs": {
            "class": "lead"
          },
          "children": [
            "Filter groups after aggregate values have been computed."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "SELECT group_column, aggregate_function(expression) AS result_name\nFROM table_name\n[WHERE row_condition]\nGROUP BY group_column\nHAVING aggregate_condition;"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "pattern"
                  },
                  "children": [
                    "Copy general pattern"
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "WHERE filters rows before grouping."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "GROUP BY forms one group for each distinct key."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "HAVING filters the completed groups."
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "Example using the course database"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "SELECT category, AVG(price) AS avg_price\nFROM Product\nGROUP BY category\nHAVING AVG(price) >= 50;"
                  ]
                }
              ]
            },
            {
