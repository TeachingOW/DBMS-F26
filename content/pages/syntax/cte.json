  "title": "Common table expression (WITH) · SQL Syntax",
  "bodyAttributes": {},
  "nodes": [
    {
      "tag": "header",
      "children": [
        {
          "tag": "p",
          "attrs": {
            "class": "eyebrow"
          },
          "children": [
            "SQL general syntax"
          ]
        },
        {
          "tag": "h1",
          "children": [
            "Common table expression (WITH)"
          ]
        }
      ]
    },
    {
      "tag": "main",
      "children": [
        "\n    ",
        {
          "tag": "p",
          "attrs": {
            "class": "lead"
          },
          "children": [
            "Name an intermediate query so a larger statement can be read in clear stages."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "WITH cte_name AS (\n  SELECT column_list\n  FROM table_name\n  [WHERE condition]\n)\nSELECT column_list\nFROM cte_name\n[JOIN another_cte ...];"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "pattern"
                  },
                  "children": [
                    "Copy general pattern"
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "The CTE exists only for the statement that follows WITH."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "Use it to separate filtering, aggregation, or ranking steps."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "Several CTEs can be separated by commas."
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "Example using the course database"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "WITH gadget_products AS (\n  SELECT name, price\n  FROM Product\n  WHERE category = 'Gadgets'\n)\nSELECT * FROM gadget_products WHERE price >= 20;"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
