      "tag": "header",
      "children": [
        {
          "tag": "p",
          "attrs": {
            "class": "eyebrow"
          },
          "children": [
            "SQL general syntax"
          ]
        },
        {
          "tag": "h1",
          "children": [
            "EXPLAIN"
          ]
        }
      ]
    },
    {
      "tag": "main",
      "children": [
        "\n    ",
        {
          "tag": "p",
          "attrs": {
            "class": "lead"
          },
          "children": [
            "Ask PostgreSQL to show the execution plan it chooses for a query."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "EXPLAIN [ANALYZE]\nSELECT column_list\nFROM table_name\nWHERE condition\n[GROUP BY column_list];"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "pattern"
                  },
                  "children": [
                    "Copy general pattern"
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "EXPLAIN shows estimated plan steps."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "EXPLAIN ANALYZE also runs the query and reports actual timing."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "Compare estimated and actual rows to diagnose weak estimates."
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "Example using the course database"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "EXPLAIN ANALYZE\nSELECT category, AVG(price)\nFROM Product\nGROUP BY category;"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
