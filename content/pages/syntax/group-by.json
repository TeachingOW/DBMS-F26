                  "children": [
                    "Copy general pattern"
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "Every selected nonaggregate expression must belong to the grouping key."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "Aggregate functions summarize rows within each group."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "Add HAVING when groups must be filtered."
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "Example using the course database"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "SELECT category, COUNT(*) AS product_count, AVG(price) AS avg_price\nFROM Product\nGROUP BY category;"
                  ]
                }
              ]
            },
