        "\n    ",
        {
          "tag": "p",
          "attrs": {
            "class": "lead"
          },
          "children": [
            "Collapse rows into groups and compute one aggregate result per group."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "SELECT group_column, aggregate_function(expression) AS result_name\nFROM table_name\n[WHERE row_condition]\nGROUP BY group_column;"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "pattern"
