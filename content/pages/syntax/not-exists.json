{
  "schemaVersion": 1,
  "title": "NOT EXISTS · SQL Syntax",
  "bodyAttributes": {},
  "nodes": [
    {
      "tag": "header",
      "children": [
        {
          "tag": "p",
          "attrs": {
            "class": "eyebrow"
          },
          "children": [
            "SQL general syntax"
          ]
        },
        {
          "tag": "h1",
          "children": [
            "NOT EXISTS"
          ]
        }
      ]
    },
    {
      "tag": "main",
      "children": [
        "\n    ",
        {
          "tag": "p",
          "attrs": {
            "class": "lead"
          },
          "children": [
            "Keep an outer row only when the correlated inner query finds no matching row."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "SELECT outer_columns\nFROM outer_table AS outer_row\nWHERE NOT EXISTS (\n  SELECT 1\n  FROM inner_table AS inner_row\n  WHERE inner_row.key = outer_row.key\n    AND counterexample_condition\n);"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "pattern"
                  },
                  "children": [
                    "Copy general pattern"
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "The subquery is evaluated in relation to each outer row."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "SELECT 1 signals that only existence matters."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "NOT EXISTS is reliable even when inner columns contain NULL."
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "Example using the course database"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "SELECT p.name\nFROM Product p\nWHERE NOT EXISTS (\n  SELECT 1 FROM Purchase pu WHERE pu.product = p.name\n);"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
