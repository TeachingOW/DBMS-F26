        "\n    ",
        {
          "tag": "p",
          "attrs": {
            "class": "lead"
          },
          "children": [
            "Build an access path that can speed up matching and sorting on selected columns."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "CREATE INDEX index_name\nON table_name (leading_column, next_column);\n\nSELECT column_list\nFROM table_name\nWHERE leading_column = value\n  AND next_column >= value;"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "pattern"
                  },
                  "children": [
                    "Copy general pattern"
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "Put commonly filtered columns first."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "An index can speed reads but adds storage and write cost."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "Use EXPLAIN to check whether the optimizer uses it."
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "Example using the course database"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "CREATE INDEX product_category_price_idx\nON Product (category, price);\n\nSELECT name, price\nFROM Product\nWHERE category = 'Gadgets' AND price >= 20;"
                  ]
                }
              ]
            },
