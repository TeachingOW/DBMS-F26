              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "CREATE TABLE table_name (\n  column_name data_type [constraint],\n  ...\n  [FOREIGN KEY (column_name) REFERENCES parent_table(parent_key)]\n);"
                  ]
                }
              ]
            },
