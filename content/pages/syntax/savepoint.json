{
  "schemaVersion": 1,
  "title": "SAVEPOINT · SQL Syntax",
  "bodyAttributes": {},
  "nodes": [
    {
      "tag": "header",
      "children": [
        {
          "tag": "p",
          "attrs": {
            "class": "eyebrow"
          },
          "children": [
            "SQL general syntax"
          ]
        },
        {
          "tag": "h1",
          "children": [
            "SAVEPOINT"
          ]
        }
      ]
    },
    {
      "tag": "main",
      "children": [
        "\n    ",
        {
          "tag": "p",
          "attrs": {
            "class": "lead"
          },
          "children": [
            "Mark a point inside a transaction so later work can be undone without discarding earlier work."
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "General pattern"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "BEGIN;\nstatement_1;\nSAVEPOINT savepoint_name;\noptional_statement;\nROLLBACK TO SAVEPOINT savepoint_name;\nCOMMIT;"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "pattern"
                  },
                  "children": [
                    "Copy general pattern"
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "How to read it"
              ]
            },
            {
              "tag": "ul",
              "children": [
                {
                  "tag": "li",
                  "children": [
                    "BEGIN starts the transaction."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "SAVEPOINT creates a partial rollback target."
                  ]
                },
                {
                  "tag": "li",
                  "children": [
                    "COMMIT makes all work not rolled back permanent."
                  ]
                }
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "card"
          },
          "children": [
            {
              "tag": "h2",
              "children": [
                "Example using the course database"
              ]
            },
            {
              "tag": "pre",
              "children": [
                {
                  "tag": "code",
                  "children": [
                    "BEGIN;\nUPDATE Product SET price = price * 0.90 WHERE category = 'Gadgets';\nSAVEPOINT price_change;\nUPDATE Product SET price = 0;\nROLLBACK TO SAVEPOINT price_change;\nCOMMIT;"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "actions"
              },
              "children": [
                {
                  "tag": "button",
                  "attrs": {
                    "type": "button",
                    "data-copy": "example"
                  },
                  "children": [
                    "Copy example"
                  ]
                }
              ]
            }
          ]
        },
