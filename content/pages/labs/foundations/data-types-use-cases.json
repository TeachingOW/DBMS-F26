    "\n  ",
    {
      "tag": "h1",
      "children": [
        "Choosing SQL Data Types from Use Cases"
      ]
    },
    "\n  ",
    {
      "tag": "p",
      "attrs": {
        "class": "callout"
      },
      "children": [
        {
          "tag": "strong",
          "children": [
            "Goal:"
          ]
        },
        " choose a type by asking what operations must be correct—not by asking what the sample value happens to look like."
      ]
    },
    "\n  ",
    {
      "tag": "h2",
      "children": [
        "Part 1 · Classify the job of the field"
      ]
    },
    "\n  ",
    {
      "tag": "div",
      "attrs": {
        "class": "grid"
      },
      "children": [
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "case"
          },
          "children": [
            {
              "tag": "h3",
              "children": [
                "Exact quantity"
              ]
            },
            {
              "tag": "p",
              "children": [
                "Money, tax rates, inventory quantities measured to a fixed scale."
              ]
            },
            {
              "tag": "p",
              "children": [
                {
                  "tag": "strong",
                  "children": [
                    "Usually:"
                  ]
                },
                " ",
                {
                  "tag": "code",
                  "children": [
                    "DECIMAL(p,s)"
                  ]
                },
                " or ",
                {
                  "tag": "code",
                  "children": [
                    "NUMERIC(p,s)"
                  ]
                },
                "."
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "case"
          },
          "children": [
            {
              "tag": "h3",
              "children": [
                "Approximate measurement"
              ]
            },
            {
              "tag": "p",
              "children": [
                "Sensor readings, scientific values, estimates where floating-point approximation is acceptable."
              ]
            },
            {
              "tag": "p",
              "children": [
                {
                  "tag": "strong",
                  "children": [
                    "Usually:"
                  ]
                },
                " ",
                {
                  "tag": "code",
                  "children": [
                    "REAL"
                  ]
                },
                " or ",
                {
                  "tag": "code",
                  "children": [
                    "DOUBLE PRECISION"
                  ]
                },
                "."
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "case"
          },
          "children": [
            {
              "tag": "h3",
              "children": [
                "Identifier"
              ]
            },
            {
              "tag": "p",
              "children": [
                "ZIP code, phone number, SKU, student ID, or account number. Leading zeros and formatting matter; arithmetic does not."
              ]
            },
            {
              "tag": "p",
              "children": [
                {
                  "tag": "strong",
                  "children": [
                    "Usually:"
                  ]
                },
                " ",
                {
                  "tag": "code",
                  "children": [
                    "CHAR"
                  ]
                },
                " or ",
                {
                  "tag": "code",
                  "children": [
                    "VARCHAR"
                  ]
                },
                "."
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "case"
          },
          "children": [
            {
              "tag": "h3",
              "children": [
                "Time"
              ]
            },
            {
              "tag": "p",
              "children": [
                "Birthday, due date, event instant, or local appointment time."
              ]
            },
            {
              "tag": "p",
              "children": [
                {
                  "tag": "strong",
                  "children": [
                    "Usually:"
                  ]
                },
                " ",
                {
                  "tag": "code",
                  "children": [
                    "DATE"
                  ]
                },
                ", ",
                {
                  "tag": "code",
                  "children": [
                    "TIME"
                  ]
                },
                ", or ",
                {
                  "tag": "code",
                  "children": [
                    "TIMESTAMP"
                  ]
                },
                "; consider time-zone semantics."
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "case"
          },
          "children": [
            {
              "tag": "h3",
              "children": [
                "State"
              ]
            },
            {
              "tag": "p",
              "children": [
                "Yes/no, active/inactive, passed/failed."
              ]
            },
            {
              "tag": "p",
              "children": [
                {
                  "tag": "strong",
                  "children": [
                    "Usually:"
                  ]
                },
                " ",
                {
                  "tag": "code",
                  "children": [
                    "BOOLEAN"
                  ]
                },
                ", unless the domain has more than two states."
              ]
            }
          ]
        },
        "\n    ",
        {
          "tag": "section",
          "attrs": {
            "class": "case"
          },
          "children": [
            {
              "tag": "h3",
              "children": [
                "Human text"
              ]
            },
            {
              "tag": "p",
              "children": [
                "Name, title, comment, or description."
              ]
            },
            {
              "tag": "p",
              "children": [
                {
                  "tag": "strong",
                  "children": [
                    "Usually:"
                  ]
                },
                " ",
                {
                  "tag": "code",
                  "children": [
                    "VARCHAR(n)"
                  ]
                },
                " for a meaningful limit or ",
                {
                  "tag": "code",
                  "children": [
                    "TEXT"
                  ]
                },
                " for open-ended content."
              ]
            }
          ]
        },
        "\n  "
      ]
    },
    "\n  ",
    {
