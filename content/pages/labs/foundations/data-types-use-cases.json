    },
    "\n  ",
    {
      "tag": "h2",
      "children": [
        "Part 3 · Build and test"
      ]
    },
    "\n  ",
    {
      "tag": "p",
      "children": [
        "Create a table named ",
        {
          "tag": "code",
          "children": [
            "event_registration"
          ]
        },
        ". Decide types and useful constraints for every field, then insert three rows designed to test the boundaries of your choices."
      ]
    },
    "\n  ",
    {
      "tag": "pre",
      "children": [
        {
          "tag": "code",
          "children": [
            "CREATE TABLE event_registration (\n    registration_id  /* choose */ PRIMARY KEY,\n    student_id       /* choose */ NOT NULL,\n    ticket_price     /* choose */ NOT NULL,\n    registered_at    /* choose */ NOT NULL,\n    needs_access     /* choose */ NOT NULL,\n    notes            /* choose */\n);"
          ]
        }
      ]
    },
    "\n  ",
    {
      "tag": "h3",
      "children": [
        "Boundary tests"
      ]
    },
    "\n  ",
    {
      "tag": "ol",
      "children": [
        {
          "tag": "li",
          "children": [
            "Use a student ID with leading zeros."
          ]
        },
        {
          "tag": "li",
          "children": [
            "Insert a price whose third decimal place is nonzero. Predict what the DBMS will do."
          ]
        },
        {
          "tag": "li",
          "children": [
            "Insert an invalid date or timestamp and record the error."
          ]
        },
        {
          "tag": "li",
          "children": [
            "Try a missing required value."
          ]
        },
        {
          "tag": "li",
          "children": [
            "Explain whether ",
            {
              "tag": "code",
              "children": [
                "needs_access"
              ]
            },
            " truly has two states or needs an “unknown/not answered” state."
          ]
        }
      ]
    },
    "\n  ",
    {
      "tag": "details",
      "children": [
        {
          "tag": "summary",
          "children": [
            "Suggested core choices"
          ]
        },
        {
          "tag": "p",
          "children": [
            {
              "tag": "code",
              "children": [
                "student_id VARCHAR(...)"
              ]
            },
            ", ",
            {
              "tag": "code",
              "children": [
                "ticket_price DECIMAL(8,2)"
              ]
            },
            ", ",
            {
              "tag": "code",
              "children": [
                "registered_at TIMESTAMP"
              ]
            },
            ", and ",
            {
              "tag": "code",
              "children": [
                "needs_access BOOLEAN"
              ]
            },
            ". The best length, nullability, default, and time-zone treatment depend on the stated requirements."
          ]
        }
      ]
    },
    "\n  ",
